{
  "name": "paygham/sdk",
  "version": "0.1.0",
  "description": "Official PHP SDK for the Paygham Messaging API.",
  "keywords": [
    "openapitools",
    "openapi-generator",
    "openapi",
    "php",
    "sdk",
    "rest",
    "api"
  ],
  "homepage": "https://github.com/SamimSafi/payghamSdks",
  "license": "proprietary",
  "authors": [
    {
      "name": "Paygham",
      "homepage": "https://github.com/SamimSafi/payghamSdks"
    }
  ],
  "require": {
    "php": "^8.1",
    "ext-curl": "*",
    "ext-json": "*",
    "ext-mbstring": "*",
    "guzzlehttp/guzzle": "^7.3",
    "guzzlehttp/psr7": "^1.7 || ^2.0"
  },
  "require-dev": {
    "phpunit/phpunit": "^8.0 || ^9.0",
    "friendsofphp/php-cs-fixer": "^3.5"
  },
  "autoload": {
    "psr-4": {
      "Paygham\\": "lib/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "Paygham\\Test\\": "test/"
    }
  },
  "support": {
    "issues": "https://github.com/SamimSafi/payghamSdks/issues",
    "source": "https://github.com/SamimSafi/payghamSdks"
  }
}
